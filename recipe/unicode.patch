         jm_log_fatal(cb, module, "Could not create a unique temporary directory name");
         return NULL;
     }
+    char* utf8 = jm_wide_to_utf8(wbuf);
+    free(wbuf);
+    if (!utf8) return NULL;
+    strcpy(tmplt, utf8);
+    free(utf8);
     if(jm_mkdir(cb, tmplt) != jm_status_success) {
         return NULL;
     }
     return tmplt;
-
 #else
     return mkdtemp(tmplt);
 #endif
 }
 
