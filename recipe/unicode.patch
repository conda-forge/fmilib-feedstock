 {
 #ifdef WIN32
-    /* Windows does not have mkdtemp, use mktemp + mkdir */
-
-    if(!_mktemp(tmplt)) {
+    wchar_t* wbuf = jm_utf8_to_wide(tmplt);
+    if (!wbuf) return NULL;
+    if (!_wmktemp(wbuf)) {
